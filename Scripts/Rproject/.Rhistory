coord_cartesian(ylim = c(0, 100)) +
scale_color_manual(
name = "MAG quality",
values = c("1.High" = "#7570b3", "2.Medium" = "#d95f02", "3.Low" = "gray40"),
labels = c("High", "Medium", "Low"),
limits = c("1.High", "2.Medium", "3.Low"), drop = FALSE
) +
annotate(
geom = "table_npc",
npcx = 0.05,
npcy = 0.95,
label = list(count_df),
size = 4,
table.theme = ttheme_gtsimple()
) +
# Changing to Mb:
scale_size_continuous(
name = "Size (Mb)",
labels = function(x) paste0(round(x / 1e6, 2), " Mb"),
limits = c(0, 600e6),
breaks = c( 1e6, 10e6, seq(50e6, 200e6, by = 50e6)),
range = c(1, 8)
) +
guides(color = guide_legend(override.aes = list(size = 4))) +
labs(
title = dfname,
x = "Completeness (%)",
y = "Contamination (%)"
) +
theme_bw()
})
#Combine all plots
combined_plot <- wrap_plots(quality_plot2, ncol = 3) + plot_layout(guides = "collect", axes = "collect")
combined_plot
ggsave(filename = paste0(out_path, "checkM2_scatterplot.png"), combined_plot, width = 16, height = 8)
